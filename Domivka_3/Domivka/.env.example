# Copy to .env on the server. Never publish .env, data or credentials.
BOT_TOKEN=
# OWNER_ID is the immutable owner. ADMIN_IDS are trusted full administrators.
OWNER_ID=
ADMIN_IDS=
WEBAPP=on
WEBAPP_PORT=8080
WEBAPP_URL=
TUNNEL=auto
PAYMENT_MODE=off
REQUIRE_APPROVAL=1
# Central carrier key belongs to the operator; users never enter API keys.
NOVA_POSHTA_API_KEY=
# Enable ONLY after a carrier-approved marketplace sender/COD arrangement.
NOVA_POSHTA_MARKETPLACE_ENABLED=0
# Operator-only JSON maps actual seller ID to provider-approved sender/contact.
# Never point all sellers' COD funds to the platform. See DELIVERY.md.
NOVA_POSHTA_SELLER_MAPPINGS={}
# Legacy encryption key is retained only for old encrypted records.
SHIPPING_MASTER_KEY=
# Public support address for digital-service payments, e.g. https://t.me/your_support
PAYMENT_SUPPORT_URL=
