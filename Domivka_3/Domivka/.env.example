# Copy to .env locally. Never commit .env or paste credentials into chats.
BOT_TOKEN=
ADMIN_IDS=
WEBAPP=on
WEBAPP_PORT=8080
WEBAPP_URL=
TUNNEL=auto
PAYMENT_MODE=off
REQUIRE_APPROVAL=1
# Encryption master key: generate once and keep a private backup.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SHIPPING_MASTER_KEY=
# Optional key ONLY for shared city/branch directories. Seller labels always
# use each seller's encrypted credentials configured inside the Mini App.
NOVA_POSHTA_API_KEY=
